{%- import 'attribute_table.j2' as at -%}
{%- import 'metric_table.j2' as mt -%}
{%- import 'event_macros.j2' as event -%}
{%- import 'entity_macros.j2' as entity -%}
{%- import 'span_macros.j2' as span -%}
{%- set attribute_registry_base_url=params.registry_base_url~"attributes" -%}
{%- set entity_registry_base_url=params.registry_base_url~"entities" -%}
{#- In v2 the jq result of the `<!-- weaver {jq} -->` marker is the root context,
    so signal fields (kind, instrument, attributes, ...) are top-level globals.
    Rebuild a single `group` object from them and reuse the type-specific macros. -#}
{%- set group = {
  "kind": kind | default(none),
  "instrument": instrument | default(none),
  "name": name | default(none),
  "type": type | default(none),
  "unit": unit | default(""),
  "brief": brief | default(""),
  "note": note | default(none),
  "stability": stability | default("development"),
  "deprecated": deprecated | default(none),
  "attributes": attributes | default([]),
  "entity_associations": entity_associations | default(none),
  "identity": identity | default([]),
  "description": description | default([]),
  "body": body | default(none)
} -%}
{%- macro generate_event(group) -%}
{{ event.header(group) }}{{ generate_attributes(group) }}{{ event.body(group.body) }}
{%- endmacro -%}
{%- macro generate_entity(group) -%}
{{ entity.header(group) | trim }}

{{ entity.all_attribute_table(group) | trim }}
{%- endmacro -%}
{%- macro generate_metric(group, entity_registry_base_url) -%}
{{ mt.generate(group, entity_registry_base_url) }}
{{ generate_attributes(group) }}
{%- endmacro -%}
{%- macro generate_span(group) -%}
{{ span.header(group) }}{{ generate_attributes(group) }}
{%- endmacro -%}
{%- macro generate_attributes(group) -%}
{{ at.generate(group.attributes, attribute_registry_base_url) }}
{%- endmacro -%}
<!-- NOTE: THIS TEXT IS AUTOGENERATED. DO NOT EDIT BY HAND. -->
<!-- see templates/registry/markdown/snippet.md.j2 -->
<!-- prettier-ignore-start -->

{% if group.kind -%}
{{ generate_span(group) | trim }}
{%- elif group.instrument -%}
{{ generate_metric(group, entity_registry_base_url) | trim }}
{%- elif group.identity or group.description -%}
{{ generate_entity(group) | trim }}
{%- elif group.name and group.attributes -%}
{{ generate_event(group) | trim }}
{%- else -%}
{{ generate_attributes(group) | trim }}
{%- endif %}

<!-- prettier-ignore-end -->
<!-- END AUTOGENERATED TEXT -->
