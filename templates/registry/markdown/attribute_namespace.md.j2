- [{{ ns_title }} Attributes](#{{ attrs.heading_link_fragments(ns_title ~ " Attributes") }})
- [Deprecated {{ ns_title }} Attributes](#{{ attrs.heading_link_fragments("Deprecated " ~ ns_title ~ " Attributes") }})
{%- endif %}
{%- if show_main %}

{{ section(ns_title ~ " Attributes", non_deprecated) | trim }}
{%- endif %}
{%- if show_deprecated %}

