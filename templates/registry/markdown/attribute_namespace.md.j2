{#- Rendered per root namespace. v2 context: { root_namespace, attributes: [...] }.
    v2 has no attribute groups, so attributes are split into a main section and a
    deprecated section. Empty sections (e.g. a fully-deprecated namespace) are
    omitted entirely, and the table-of-contents is only rendered when both
    sections are present. -#}
{%- import 'stability.j2' as stability -%}
{%- import 'notes.j2' as notes -%}
{%- import 'enum_macros.j2' as enums -%}
{%- import 'attribute_macros.j2' as attrs -%}
{%- import 'examples_macros.j2' as examples -%}
{%- macro section(title, attributes) -%}
## {{ title }}

**Attributes:**

| Key | Stability | Value Type | Description | Example Values |
| --- | --- | --- | --- | --- |
{%- for attribute in attributes | sort(attribute="key") %}{% set attr_anchor = attribute.key | kebab_case %}
| <a id="{{ attr_anchor }}" href="#{{ attr_anchor }}">`{{ attrs.name(attribute) }}`</a> | {{ stability.badge(attribute.stability, attribute.deprecated, attribute.brief) | trim }} | {{ attrs.type(attribute) }} | {{ attribute.brief | trim }}{{ notes.add({"note": attribute.note, "name": attrs.name(attribute) | trim}) }} | {{ examples.format(attribute) }}|
{%- endfor %}
{{ notes.render() }}
{%- for enum in attributes | sort(attribute="key") %}
{%- if enum.type is mapping -%}{{ enums.table(enum, notes) }}{% endif %}
{%- endfor -%}
{%- endmacro -%}
{%- set ns_title = attrs.map_or(ctx.root_namespace, attrs.humanize(attrs.sentence_case(ctx.root_namespace)) | acronym) | trim -%}
{%- set non_deprecated = ctx.attributes | rejectattr("deprecated", "defined") | list -%}
{%- set deprecated = ctx.attributes | selectattr("deprecated", "defined") | list -%}
{%- set show_main = non_deprecated | length > 0 -%}
{%- set show_deprecated = deprecated | length > 0 -%}

<!-- NOTE: THIS FILE IS AUTOGENERATED. DO NOT EDIT BY HAND. -->
<!-- see templates/registry/markdown/attribute_namespace.md.j2 -->

# {{ ns_title }}
