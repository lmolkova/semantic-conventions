{%- import "macros.j2" as m -%}
{%- set enabled = ctx.group_properties | selectattr("prop.type", "equalto", "toggle") | first -%}
package {{ params.package_root }}.{{ ctx.domain }};

import io.opentelemetry.api.common.Attributes;
{% if ctx.is_exception %}import io.opentelemetry.api.incubator.logs.ExtendedLogRecordBuilder;
{% endif %}import io.opentelemetry.api.incubator.config.ConfigProvider;
import io.opentelemetry.api.incubator.config.DeclarativeConfigProperties;
import io.opentelemetry.api.logs.Logger;
import io.opentelemetry.api.logs.Severity;
import io.opentelemetry.semconv.prototype.config.Config;

public final class {{ ctx.class_name | pascal_case }}Event {

  private static final String SCOPE = "general.{{ ctx.scope }}";
  private static final String NAME = "{{ ctx.event_name }}";

  private final Logger logger;
  private final boolean enabled;

  private {{ ctx.class_name | pascal_case }}Event(Logger logger, ConfigProvider configProvider) {
    DeclarativeConfigProperties config = Config.instrumentation(configProvider);
    this.logger = logger;
{%- if enabled and ctx.experimental %}
    this.enabled = Config.experimental(config, "{{ ctx.domain }}")
        && Config.at(config, SCOPE).getBoolean("{{ enabled.name }}", {{ m.toggle_default(ctx.requirement_level) }});
{%- elif enabled %}
    this.enabled = Config.at(config, SCOPE).getBoolean("{{ enabled.name }}", {{ m.toggle_default(ctx.requirement_level) }});
{%- elif ctx.experimental %}
    this.enabled = Config.experimental(config, "{{ ctx.domain }}");
{%- else %}
    this.enabled = true;
{%- endif %}
  }

  public static {{ ctx.class_name | pascal_case }}Event create(
      Logger logger, ConfigProvider configProvider) {
    return new {{ ctx.class_name | pascal_case }}Event(logger, configProvider);
  }

  public boolean isEnabled() {
    return enabled;
  }
{% if ctx.is_exception %}
  public void emit(Severity severity, Throwable throwable) {
    emit(severity, throwable, Attributes.empty());
  }

  public void emit(
      Severity severity,
      Throwable throwable,
      Attributes attributes) {
    if (!enabled) {
      return;
    }
    ExtendedLogRecordBuilder builder = (ExtendedLogRecordBuilder) logger.logRecordBuilder();
    builder
        .setEventName(NAME)
        .setSeverity(severity)
        .setException(throwable)
        .setAllAttributes(attributes)
        .emit();
  }
{%- else %}
  public void emit(Severity severity, Attributes attributes) {
    if (!enabled) {
      return;
    }
    logger
        .logRecordBuilder()
        .setEventName(NAME)
        .setSeverity(severity)
        .setAllAttributes(attributes)
        .emit();
  }
{%- endif %}
}
