{%- import "macros.j2" as m -%}
{%- set enabled = ctx.group_properties | selectattr("prop.type", "equalto", "toggle") | first -%}
{%- set toggle_bindings = ctx.config_bindings | selectattr("config.prop.type", "equalto", "toggle") | list -%}
{%- set experimental_attributes = ctx.attributes | selectattr("config_experimental") | list -%}
{%- set list_attributes = ctx.attributes | selectattr("type", "equalto", "string[]") | list -%}
{%- set value_type = "double" if ctx.value_type == "double" else "long" -%}
{%- set ps = namespace(list=[value_type ~ " value"]) -%}
{%- for a in ctx.attributes -%}
{%- set ps.list = ps.list + [m.java_type(a) ~ " " ~ (a.name | camel_case)] -%}
{%- endfor -%}
package {{ params.package_root }}.{{ ctx.domain }};

import io.opentelemetry.api.common.Attributes;
import io.opentelemetry.api.common.AttributesBuilder;
import io.opentelemetry.api.incubator.config.ConfigProvider;
import io.opentelemetry.api.incubator.config.DeclarativeConfigProperties;
import io.opentelemetry.api.metrics.{{ "DoubleHistogram" if ctx.instrument == "histogram" else "LongUpDownCounter" }};
import io.opentelemetry.api.metrics.Meter;
import io.opentelemetry.semconv.prototype.config.Config;
{%- if list_attributes %}
import java.util.List;
{%- endif %}

public final class {{ ctx.class_name | pascal_case }}Metric {

  private static final String SCOPE = "general.{{ ctx.scope }}";
  private static final String NAME = "{{ ctx.metric_name }}";

  private final {{ "DoubleHistogram" if ctx.instrument == "histogram" else "LongUpDownCounter" }} instrument;
  private volatile State state;

  private {{ ctx.class_name | pascal_case }}Metric(Meter meter, ConfigProvider configProvider) {
    this.state = new State(Config.instrumentation(configProvider));
    this.instrument = meter
{%- if ctx.instrument == "histogram" %}
        .histogramBuilder(NAME)
{%- else %}
        .upDownCounterBuilder(NAME)
{%- endif %}
        .setUnit("{{ ctx.unit }}")
        .setDescription("{{ ctx.brief | trim | replace("\"", "'") | replace("\n", " ") }}")
        .build();
  }

  private static final class State {

    private final boolean enabled;
{%- if experimental_attributes %}
    private final boolean experimental;
{%- endif %}
{%- for a in toggle_bindings %}
    private final boolean {{ a.config.name | camel_case }};
{%- endfor %}

    private State(DeclarativeConfigProperties config) {
{%- if enabled and ctx.experimental %}
      this.enabled = Config.experimental(config, "{{ ctx.domain }}")
          && Config.at(config, SCOPE).getBoolean("{{ enabled.name }}", {{ m.toggle_default(ctx.requirement_level) }});
{%- elif enabled %}
      this.enabled = Config.at(config, SCOPE).getBoolean("{{ enabled.name }}", {{ m.toggle_default(ctx.requirement_level) }});
{%- elif ctx.experimental %}
      this.enabled = Config.experimental(config, "{{ ctx.domain }}");
{%- else %}
      this.enabled = true;
{%- endif %}
{%- if experimental_attributes %}
      this.experimental = Config.experimental(config, "{{ ctx.domain }}");
{%- endif %}
{%- for a in toggle_bindings %}
      this.{{ a.config.name | camel_case }} = {{ m.config_at(a) }}
          .getBoolean("{{ a.config.name }}", {{ m.toggle_default(a.requirement_level) }});
{%- endfor %}
    }
  }

  public static {{ ctx.class_name | pascal_case }}Metric create(
      Meter meter, ConfigProvider configProvider) {
    {{ ctx.class_name | pascal_case }}Metric result =
        new {{ ctx.class_name | pascal_case }}Metric(meter, configProvider);
    Config.onInstrumentationChange(configProvider, config -> result.state = new State(config));
    return result;
  }

  public boolean isEnabled() {
    return state.enabled;
  }

  public void {{ "record" if ctx.instrument == "histogram" else "add" }}(
      {{ ps.list | join(",\n      ") }}) {
    State state = this.state;
    if (!state.enabled) {
      return;
    }
    AttributesBuilder attributes = Attributes.builder();
{%- for a in ctx.attributes %}
{%- set toggle = a.configs | selectattr("prop.type", "equalto", "toggle") | first %}
{%- if toggle or a.config_experimental %}
    if ({% if toggle %}state.{{ toggle.name | camel_case }} && {% endif %}{% if a.config_experimental %}state.experimental && {% endif %}{{ a.name | camel_case }} != null) {
      attributes.put({{ m.attributes_class(ctx.domain) }}.{{ m.const(a.name) }}, {{ a.name | camel_case }});
    }
{%- else %}
    if ({{ a.name | camel_case }} != null) {
      attributes.put({{ m.attributes_class(ctx.domain) }}.{{ m.const(a.name) }}, {{ a.name | camel_case }});
    }
{%- endif %}
{%- endfor %}
    instrument.{{ "record" if ctx.instrument == "histogram" else "add" }}(value, attributes.build());
  }
}
